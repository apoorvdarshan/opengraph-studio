{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "opengraph-studio",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "opengraph.apoorvdarshan.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
